# ============================================
# FRONTEND (Vercel) - VITE_ prefix required
# ============================================
VITE_API_URL=

# ============================================
# BACKEND (Vercel Serverless) - Set in Vercel Dashboard
# ============================================
# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/taskpanda?retryWrites=true&w=majority

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Email (SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=TaskPanda <no-reply@yourdomain.com>

# Frontend URL (for CORS & email links)
FRONTEND_URL=https://your-app.vercel.app

# Cloudinary (for file uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret